{
	"name": "test",
	"properties": {
		"activities": [
			{
				"name": "read_metadata_sql",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT *\nFROM ctrl.table_config\nWHERE is_active = 1\n  AND source_system = '@{pipeline().parameters.src_system}';",
							"type": "Expression"
						},
						"queryTimeout": "00:58:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azure_sql_table",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			}
		],
		"parameters": {
			"src_system": {
				"type": "string",
				"defaultValue": "adls_csv"
			}
		},
		"annotations": []
	}
}