{
	"name": "pl_silver_to_gold",
	"properties": {
		"activities": [
			{
				"name": "read_metadata_sql",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT table_id , gold_table_name\nFROM ctrl.table_config\nWHERE is_active = 1\n  AND stage = 'SILVER_TO_GOLD';",
							"type": "Expression"
						},
						"queryTimeout": "00:58:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azure_sql_table",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ingest_tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "read_metadata_sql",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('read_metadata_sql').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Updating Current status to IN-PROGRESS",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "ls_medisync_sqldb",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "@concat(\n    'INSERT INTO ctrl.audit_log (adf_run_id, table_id, stage, status, start_time) VALUES (''',\n    pipeline().RunId,\n    ''', ',\n    string(item().table_id),\n    ', ''SILVER_TO_GOLD'', ''IN_PROGRESS'', SYSUTCDATETIME());'\n)",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "Updating Current status to Failed",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Silver to Gold",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "ls_medisync_sqldb",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "@concat(\n    'UPDATE ctrl.audit_log SET status = ''FAILED'', end_time = SYSUTCDATETIME() WHERE adf_run_id = ''',\n    pipeline().RunId,\n    ''' AND table_id = ',\n    string(item().table_id),\n    ' AND stage = ''',\n    'SILVER_TO_GOLD',\n    ''' AND status = ''IN_PROGRESS'';'\n)",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "Silver to Gold",
							"type": "DatabricksNotebook",
							"dependsOn": [
								{
									"activity": "Updating Current status to IN-PROGRESS",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": {
									"value": "/medi_sync/medi-sync-adb/Gold/NB_@{item().gold_table_name}",
									"type": "Expression"
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_medisync_adb",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "Updating Current status to SUCCESS",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Silver to Gold",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "ls_medisync_sqldb",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "UPDATE ctrl.audit_log\nSET\n    status = 'SUCCESS',\n    end_time = SYSUTCDATETIME(),\n    records_written = @{activity('Silver to Gold').output.runoutput}\nWHERE adf_run_id = pipeline().RunId\n  AND table_id = @{item().table_id}\n  AND stage = 'SILVER_TO_GOLD'\n  AND status = 'IN_PROGRESS';",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "a3"
			}
		},
		"variables": {
			"Test": {
				"type": "String"
			}
		},
		"annotations": []
	}
}