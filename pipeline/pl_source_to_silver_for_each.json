{
	"name": "pl_source_to_silver_for_each",
	"properties": {
		"activities": [
			{
				"name": "read_table_metadata",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM ctrl.table_config WHERE table_id = @{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azure_sql_table",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "start_time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "start_time",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "source_to_landing",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "start_time",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "read_table_metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat(\n    'SELECT * FROM dbo.',\n    activity('read_table_metadata').output.firstRow.source_table_name\n)",
							"type": "Expression"
						},
						"queryTimeout": "00:10:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_azure_sql_table",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_landing_parquet",
						"type": "DatasetReference",
						"parameters": {
							"container": "landing",
							"folder": {
								"value": "@concat(\n    activity('read_table_metadata').output.firstRow.source_system,\n    '/',\n    activity('read_table_metadata').output.firstRow.source_table_name,\n    '/',\n    variables('start_time')\n)",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Landing to bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "source_to_landing",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/medi_sync/medi-sync-adb/Landing_to_Bronze",
					"baseParameters": {
						"landing_timestamp": {
							"value": "@variables('start_time')",
							"type": "Expression"
						},
						"source_system": {
							"value": "@activity('read_table_metadata').output.firstRow.source_system",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('read_table_metadata').output.firstRow.source_table_name",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_medisync_adb",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "bronze to silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Landing to bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/medi_sync/medi-sync-adb/Bronze_to_Silver",
					"baseParameters": {
						"landing_timestamp": {
							"value": "@variables('start_time')",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('read_table_metadata').output.firstRow.source_table_name",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_medisync_adb",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Updating Current status to Success",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "bronze to silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_medisync_sqldb",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "UPDATE ctrl.audit_log\nSET status = 'SUCCESS'\n    end_time = SYSUTCDATETIME()\n    where adf_run_id = '@{pipeline().parameters.adf_run_id}'\n     and table_id = @{pipeline().parameters.table_id}",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string"
			},
			"adf_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"start_time": {
				"type": "String"
			}
		},
		"annotations": []
	}
}